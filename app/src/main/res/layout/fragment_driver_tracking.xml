<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomSheet" />

    <!-- Modern Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Drag Handle Indicator -->
            <View
                android:id="@+id/dragHandle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@color/gray_300"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="16dp"/>

            <!-- Status and ETA chips -->
            <LinearLayout
                android:id="@+id/llStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/dragHandle">

                <TextView
                    android:id="@+id/tvEta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Driver Assigned\nETA: 3 min"
                    android:textColor="@color/primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/gray_200"
                app:layout_constraintTop_toBottomOf="@id/llStatus" />

            <!-- Driver Info -->
            <ImageView
                android:id="@+id/ivDriverAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_driver_avatar"
                android:padding="12dp"
                app:tint="@color/primary"
                app:layout_constraintTop_toBottomOf="@id/divider1"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Driver Name"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/ivDriverAvatar"
                app:layout_constraintStart_toEndOf="@id/ivDriverAvatar" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_fare_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintBottom_toBottomOf="@id/tvDriverName"
                app:layout_constraintTop_toTopOf="@id/tvDriverName"
                app:layout_constraintStart_toEndOf="@id/tvDriverName">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star"
                    app:tint="#FFC107" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.9"
                    android:textSize="12sp"
                    android:textColor="@color/gray_900"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDriverVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle"
                android:textColor="@color/gray_600"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvDriverName"
                app:layout_constraintStart_toStartOf="@id/tvDriverName" />

            <TextView
                android:id="@+id/tvDriverPlate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plate"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_fare_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivDriverAvatar"
                app:layout_constraintBottom_toBottomOf="@id/ivDriverAvatar"/>

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/gray_200"
                app:layout_constraintTop_toBottomOf="@id/ivDriverAvatar" />

            <!-- Ride Details Hidden/Simplified for Tracking to focus on map -->
            <LinearLayout
                android:id="@+id/llRideDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider2">
                
                <TextView
                    android:id="@+id/tvFare"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Fare"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Distance"
                    android:textAlignment="center"
                    android:textColor="@color/gray_700"
                    android:textSize="14sp" />
                    
                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Duration"
                    android:textAlignment="center"
                    android:textColor="@color/gray_700"
                    android:textSize="14sp" />
                    
                <TextView
                    android:id="@+id/tvVehicleType"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Type"
                    android:textAlignment="center"
                    android:textColor="@color/gray_700"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompleteRide"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Finish Ride"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                android:backgroundTint="@color/primary"
                app:layout_constraintTop_toBottomOf="@id/llRideDetails"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
