<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="20dp"
        android:background="@drawable/circle_white"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="#0F172A" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GoRide.BottomSheet"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <View
                android:id="@+id/handle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#E2E8F0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:text="Confirm address"
                android:textColor="#0F172A"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/handle" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#F1F5F9"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <ImageView
                android:id="@+id/ivIndicator"
                android:layout_width="16dp"
                android:layout_height="70dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_route_indicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider" />

            <TextView
                android:id="@+id/tvPickupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Current location"
                android:textColor="#0F172A"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/ivIndicator"
                app:layout_constraintTop_toTopOf="@id/ivIndicator" />

            <TextView
                android:id="@+id/tvPickupAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="Fetching location..."
                android:textColor="#64748B"
                android:textSize="13sp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@id/tvDestLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tvPickupLabel"
                app:layout_constraintTop_toBottomOf="@id/tvPickupLabel"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tvDestLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Destination"
                android:textColor="#0F172A"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/ivIndicator"
                app:layout_constraintStart_toEndOf="@id/ivIndicator" />

            <TextView
                android:id="@+id/tvDestAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@+id/btnConfirm"
                app:layout_constraintEnd_toStartOf="@+id/tvDistance"
                app:layout_constraintStart_toStartOf="@id/tvDestLabel"
                app:layout_constraintTop_toBottomOf="@id/tvDestLabel"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/tvDestAddress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDestLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/primary"
                android:fontFamily="sans-serif-black"
                android:text="Confirm Location"
                android:textAllCaps="false"
                android:textSize="18sp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/ivIndicator" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>